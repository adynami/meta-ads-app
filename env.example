# ── Auth ──
AUTH_SECRET=  # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# ── Meta App ──
META_APP_ID=
META_APP_SECRET=

# ── Database (Neon Postgres) ──
DATABASE_URL=postgresql://...

# ── Encryption (for storing Meta tokens) ──
ENCRYPTION_KEY=  # openssl rand -hex 32 (64 hex chars = 32 bytes)

# ── Anthropic ──
ANTHROPIC_API_KEY=sk-ant-...

# ── Stripe ──
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...
STRIPE_CREDIT_PACK_12_PRICE_ID=price_...
STRIPE_CREDIT_PACK_45_PRICE_ID=price_...
STRIPE_CREDIT_PACK_120_PRICE_ID=price_...

# ── Dev fallback (optional — for testing without DB/auth) ──
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_...
# META_API_VERSION=v25.0
