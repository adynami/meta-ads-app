# ── Auth ──
AUTH_SECRET=  # openssl rand -base64 32
AUTH_URL=http://localhost:3000

# ── Meta App ──
META_APP_ID=
META_APP_SECRET=

# ── Database (Neon Postgres) ──
DATABASE_URL=postgresql://...

# ── Encryption (for storing Meta tokens) ──
ENCRYPTION_KEY=  # openssl rand -hex 32 (64 hex chars = 32 bytes)

# ── Anthropic ──
ANTHROPIC_API_KEY=sk-ant-...
# CHAT_MODEL=claude-opus-5-5     # must support adaptive thinking + tool search
# CHAT_EFFORT=medium             # low | medium | high | xhigh | max (fixed per deployment)
# MAX_TURN_COST_CENTS=60         # hard model-spend ceiling for one chat credit

# ── Shared rate limiting (Upstash Redis) — required in production ──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Attachments (Vercel Blob) — without it, only <3 MB images work (dev) ──
BLOB_READ_WRITE_TOKEN=

# ── Daily alerts cron (Vercel sends it as a Bearer token) ──
CRON_SECRET=  # openssl rand -hex 32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe ──
STRIPE_SECRET_KEY=sk_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_BASIC_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_AGENCY_PRICE_ID=price_...
STRIPE_CREDIT_PACK_12_PRICE_ID=price_...
STRIPE_CREDIT_PACK_45_PRICE_ID=price_...
STRIPE_CREDIT_PACK_120_PRICE_ID=price_...

# ── Dev fallback (optional — NODE_ENV=development only, ignored in production) ──
# META_ACCESS_TOKEN=
# META_AD_ACCOUNT_ID=act_...
# META_API_VERSION=v25.0
